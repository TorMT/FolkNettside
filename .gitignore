# Reproducible build outputs and local caches
/export*/
**/__pycache__/
*.py[cod]
**/.cache/
/.siteupdater-backups/
/_siteupdater_dryrun.txt
/tmp_*
/temp/
/temp_subs/
*.bak
*.bak.*
*.backup_*
*.orig.html
.venv/
venv/
node_modules/
/playwright-report/
/test-results/
/audit-inventory.json

# Production document archive (application code/indexes are tracked normally)
*.pdf
*.stl
*.3mf
*.step
*.stp
*.iges
*.igs
*.f3d
*.f3z
*.fbm
*.fm3
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx
*.zip
*.7z
*.rar
*.gcode
!tests/fixtures/**
!assets/pdf/goyplassholder.pdf

# Secrets and private/local configuration; keep these last
.env
.env.*
!.env*.example
*.secret
**/secrets/
**/private/
*.local.json
*.private.json
**/linkedin-token.json
**/linkedin-refresh-token.json
**/github-token.json
**/github-refresh-token.json
.vscode/settings.json
.vscode/launch.json
